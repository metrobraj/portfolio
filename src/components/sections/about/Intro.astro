---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import ImageContainer from "../../elements/ImageContainer.astro";

// assets
import peter from "../../../assets/images/peter.jpg";
---

<Container variant={'xl'}>
    <Heading tagName="h1" tagSize="h1" class="text-center">Meet Brajendra</Heading>
    <div class="flex md:flex-row flex-col gap-16 md:items-center">
        <div class="flex-1 flex flex-col gap-7">
            <Text variant={'xl'} class="text-base-900">I'm a creative developer passionate about crafting experiences that connect with audiences through thoughtful design and strategic thinking.</Text>
            <Text variant={'sm'} class="text-base-900">For the past few years, I've been solving complex challenges through design and creative thinking. I believe great design and products isn't just about making things look beautiful—it's about understanding people, solving problems, and creating meaningful connections between people and software.</Text>
        </div>
        <div class="flex-1 md:h-[500px] w-full">
            <ImageContainer src={peter} alt="Peter"/>
        </div>
    </div>
</Container>