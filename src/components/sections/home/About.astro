---
// components
import Heading from "../../elements/Heading.astro";
import Text from "../../elements/Text.astro";
import Container from "../../elements/Container.astro";
import Link from "../../elements/Link.astro";
import ImageContainer from "../../elements/ImageContainer.astro";

// assets
import peter2 from "../../../assets/images/peter2.png";
---

<Container variant={'xl'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">About</Heading>
    <div class="flex lg:flex-row lg:gap-16 gap-10 flex-col">
        <div class="flex flex-col items-start gap-6 lg:pt-6 text-base-900 lg:flex-1">
            <Text variant={'xl'}>I'm a creative problem-solver who thrives at the intersection of design, product-development, and human behavior.</Text>
            <Text variant={'sm'}>With a passion for crafting intuitive and delightful experiences, I translate complex challenges into elegant solutions that create meaningful impact.</Text>
            <Text variant={'sm'}>When I'm not workin' on code, you'll find me playing games, experimenting with beats, or diving into books and movies. I believe the best design and product comes from understanding people.</Text>
            <Link variant={'button'} href="/about">More about me</Link>
        </div>
        <div class="w-full lg:h-[500px] h-auto lg:flex-1">
            <ImageContainer src={peter2} alt="Peter Jones" />
        </div>
    </div>
</Container>