---
// components
import Container from "../../elements/Container.astro";
import Heading from "../../elements/Heading.astro";
import Dropdown from "../../elements/Dropdown.astro";
import ContainerBottom from "../../elements/ContainerBottom.astro";

// content
const services = [
    { 
        title: "Web Design",
        text: "...focusing on creating digital experiences that engage users, communicate meaningful stories, and drive conversions across all devices.."
    },
    { 
        title: "Product Design",
        text: "...from initial sketches to manufacturing-ready prototypes, I balance form and function to create products that resonate with users and stand out in the market.."
    },
    { 
        title: "Games",
        text: "...focusing on crafting interactive worlds, compelling game mechanics, and memorable player experiences that spark curiosity across every session.."
    },
    { 
        title: "Project",
        text: "...through research-driven insights and user-centered design principles, I create interfaces that solve real problems while delivering exceptional experiences.."
    },
]
---

<Container variant={'md'}>
    <Heading tagName="h2" tagSize="h2" class="text-center">Stuff I do</Heading>
    <div class="flex flex-col gap-4">
        <Container class="flex flex-col gap-4 p-6 border-3 border-base-900">
            {
                services.map((service, index) => (
                    <Dropdown title=`${index + 1}. ${service.title}` text={service.text} />  
                ))
            }       
        </Container>
        <ContainerBottom />    
    </div>

</Container>